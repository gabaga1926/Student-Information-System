<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentSystem.Mobile.Views.StudentDetailPage"
             Title="Student details">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Student ID" FontAttributes="Bold" />
            <Label Text="{Binding StudentId}" />
            <Label Text="First name" FontAttributes="Bold" />
            <Label Text="{Binding FirstName}" />
            <Label Text="Last name" FontAttributes="Bold" />
            <Label Text="{Binding LastName}" />
            <Label Text="Full name" FontAttributes="Bold" />
            <Label Text="{Binding FullName}" />
            <Label Text="Gender" FontAttributes="Bold" />
            <Label Text="{Binding Gender}" />
            <Label Text="Year level" FontAttributes="Bold" />
            <Label Text="{Binding YearLevel}" />
            <Label Text="Program" FontAttributes="Bold" />
            <Label Text="{Binding Program}" />
            <Label Text="Contact number" FontAttributes="Bold" />
            <Label Text="{Binding ContactNumber}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
