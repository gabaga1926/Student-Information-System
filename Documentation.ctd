    <node unique_id="21" master_id="0" name="UI Layout &amp; Controls" prog_lang="custom-colors" tags="" readonly="0" nosearch_me="0" nosearch_ch="0" custom_icon_id="0" is_bold="0" foreground="" ts_creation="1792703477" ts_lastsave="1792739301">
